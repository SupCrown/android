<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Controller">

    <ImageButton
        android:id="@+id/leftArrow"
        android:layout_width="99dp"
        android:layout_height="89dp"
        android:contentDescription="fleche"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/imageView6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.747"
        app:layout_constraintStart_toEndOf="@+id/imageView5"
        app:layout_constraintTop_toTopOf="@+id/imageView6"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/fleche_removebg_preview" />

    <ImageButton
        android:id="@+id/imageView5"
        android:layout_width="97dp"
        android:layout_height="87dp"
        android:background="@android:color/transparent"
        android:rotation="180"
        android:contentDescription="fleche"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/leftArrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.146"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/leftArrow"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/fleche_removebg_preview" />

    <ImageButton
        android:id="@+id/imageView6"
        android:layout_width="97dp"
        android:layout_height="91dp"
        android:background="@android:color/transparent"
        android:rotation="270"
        android:contentDescription="fleche"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/leftArrow"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.425"
        app:srcCompat="@drawable/fleche_removebg_preview"
        tools:ignore="DuplicateIds" />

    <ImageButton
        android:id="@+id/imageView6"
        android:layout_width="97dp"
        android:layout_height="91dp"
        android:background="@android:color/transparent"
        android:rotation="90"
        android:contentDescription="fleche"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/leftArrow"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toBottomOf="@+id/imageView6"
        app:layout_constraintVertical_bias="0.618"
        app:srcCompat="@drawable/fleche_removebg_preview"
        tools:ignore="DuplicateIds,NotSibling" />

    <ImageButton
        android:id="@+id/shutbuttonid"
        android:layout_width="133dp"
        android:layout_height="116dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="fleche"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.846"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.891"
        app:srcCompat="@drawable/target" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Game"
        android:textColor="@color/black"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.107" />
</androidx.constraintlayout.widget.ConstraintLayout>